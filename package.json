{
  "name": "english-learning",
  "homepage": "https://hina-kasumi.github.io/english-learning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predev": "npm run index",
    "index": "node --import tsx scripts/build-search-index.ts",
    "validate": "node --import tsx scripts/validate-content.ts",
    "coverage": "node --import tsx scripts/coverage-report.ts",
    "prebuild": "npm run validate && npm run index",
    "test": "vitest run",
    "format": "prettier --write src scripts content/grammar/*.json",
    "format:check": "prettier --check src scripts",
    "test:e2e": "playwright test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
